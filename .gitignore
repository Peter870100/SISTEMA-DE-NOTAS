# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# planilha de referência — contém nomes e notas reais de alunos (dado sensível,
# já importado no Supabase, não precisa estar versionado)
/planilha

# estado local de ferramentas (não é parte do app)
/.claude

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
